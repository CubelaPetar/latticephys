"""
Draw an arbitrary crystal structure with given properties of the atoms / ions / molecules / ... 
"""

# ------# Modules #--------#

import math
import numpy as np
import matplotlib.pylab as plt
# import json

# -------------------------#

# -----# Constants #-------#

PX = 1 / plt.rcParams["figure.dpi"]  # pixel in inches
# plt.style.use('dark_background')

MAX_POINTS_X = 8
MAX_POINTS_Y = 8
# LATTICES                = open('lattices.json')
# LATTICE_PROPERTIES      = json.load(LATTICES)
# LATTICES.close()

# -------------------------#


class CrystalStructure:
    """
    Create a crystal structure based on the Bravais lattice and a basis.

    Instances:

    lattice:            Name of the desired Bravais lattice. Choose from:
                        Oblique, Rectangular, Centered Rectangular, Square, Hexagonal
    lattice_consts      list of lattice constants of conventional cell (in units of Angstrom)
    basis:              list of lists of the basis points. E.g. [ [ 0, 0 ], [ a/2 , a/2 ] ]
    radius:             list of radii of the basis (in units of Angstrom)
    color:              list of colors of the basis
    atom:               list of names of the atoms /ions / molecules

    """

    def __init__(
        self,
        lattice: str,
        basis: list,
        radii: list,
        colors: list,
        atoms: list,
        lattice_consts: list,
    ) -> None:
        """Define structures as objects with all relevant attributes"""

        # TODO: define the vectors for the positions of the atoms as \vec{R}_{n,\mu} = \vec{R}_{n} + R_{\mu}

        self.lattice = lattice
        self.basis = basis

        self.radii = radii
        self.colors = colors
        self.atoms = atoms
        self.lattice_consts = lattice_consts

        self.coordinates = []
        self.centered = False
        self.volumes = [
            math.pi * self.radii[i] ** 2 for i in range(0, len(self.radii))
        ]  # area occupied by the atom/ion

        self.BOUND_X = self.lattice_consts[0] * int(MAX_POINTS_X / 2)
        self.BOUND_Y = self.lattice_consts[1] * int(MAX_POINTS_Y / 2)
        # self.lattice_properties = LATTICE_PROPERTIES

        self.lattice_properties = {
            "Oblique": {
                "angle": 79,  # Arbitrary in general (\neq to n * \pi, n \in \mathds{Z})
                "centerd": False,
                "lattice system": "Monoclinic",
                "lattice_vec_x_primitive": self.lattice_consts[0]
                * np.array([1.0, 0.0]),
                "lattice_vec_y_primitive": self.lattice_consts[1]
                * np.array(
                    [math.cos(math.pi * 79 / 180.00), math.sin(math.pi * 79 / 180.00)]
                ),
            },
            "Rectangular": {
                "angle": 90,
                "centerd": False,
                "lattice system": "Orthorhombic",
                "lattice_vec_x_primitive": self.lattice_consts[0]
                * np.array([1.0, 0.0]),
                "lattice_vec_y_primitive": self.lattice_consts[1]
                * np.array([0.0, 1.0]),
            },
            "Centered Rectangular": {
                "angle": 90,
                "centerd": True,
                "lattice system": "Orthorhombic",
                "lattice_vec_x_primitive": 1
                / 2
                * np.array([self.lattice_consts[0], self.lattice_consts[1]]),
                "lattice_vec_y_primitive": 1
                / 2
                * np.array([self.lattice_consts[0], -self.lattice_consts[1]]),
                "lattice_vec_x_conventional": self.lattice_consts[0]
                * np.array([1.0, 0.0]),
                "lattice_vec_y_conventional": self.lattice_consts[1]
                * np.array([0.0, 1.0]),
            },
            "Square": {
                "angle": 90,
                "centerd": False,
                "lattice system": "Tetragonal",
                "lattice_vec_x_primitive": self.lattice_consts[0]
                * np.array([1.0, 0.0]),
                "lattice_vec_y_primitive": self.lattice_consts[1]
                * np.array([0.0, 1.0]),
            },
            "Hexagonal": {
                "angle": 60,
                "centerd": False,
                "lattice system": "Hexagonal",
                "lattice_vec_x_primitive": 1
                / 2
                * self.lattice_consts[0]
                * np.array([3.0, math.sqrt(3.0)]),
                "lattice_vec_y_primitive": 1
                / 2
                * self.lattice_consts[1]
                * np.array([3.0, -math.sqrt(3.0)]),
            },
        }

    def draw(self) -> None:
        """draw the crystal structure after the basis is set"""

        fig, axis = plt.subplots(
            figsize=(600 * PX, 600 * PX), dpi=72
        )  # dpi = 72 --> 1 pixel = 1 point

        # -------------------------- Draw crystal structure --------------------------------#

        # for atom in atoms plot each Bravais lattice
        for atom_index in range(0, len(self.basis)):
            position = self.position(atom_index)
            axis.scatter(
                [position[i][0] for i in range(0, len(position))],
                [position[i][1] for i in range(0, len(position))],
                s=self.volumes[atom_index] ** 2,
                c=self.colors[atom_index],
                alpha=0.5,
            )

        # self.get_nearest_neighbor_distance()

        # ----------------------------------------------------------------------------------#

        # ------------------------- Plot the PRIMITIVE unit cell ---------------------------#

        lattice_vec_x_primitive = self.lattice_properties[self.lattice][
            "lattice_vec_x_primitive"
        ]
        lattice_vec_y_primitive = self.lattice_properties[self.lattice][
            "lattice_vec_y_primitive"
        ]

        plt.plot(
            (0, lattice_vec_x_primitive[0]),
            (0, lattice_vec_x_primitive[1]),
            c="orange",
            lw=1,
            ls="-.",
        )
        plt.plot(
            (0, lattice_vec_y_primitive[0]),
            (0, lattice_vec_y_primitive[1]),
            c="orange",
            lw=1,
            ls="-.",
        )

        plt.plot(
            (
                lattice_vec_x_primitive[0],
                (lattice_vec_x_primitive + lattice_vec_y_primitive)[0],
            ),
            (
                lattice_vec_x_primitive[1],
                (lattice_vec_x_primitive + lattice_vec_y_primitive)[1],
            ),
            c="orange",
            lw=1,
            ls="-.",
        )
        plt.plot(
            (
                lattice_vec_y_primitive[0],
                (lattice_vec_x_primitive + lattice_vec_y_primitive)[0],
            ),
            (
                lattice_vec_y_primitive[1],
                (lattice_vec_x_primitive + lattice_vec_y_primitive)[1],
            ),
            c="orange",
            lw=1,
            ls="-.",
        )

        # ----------------------------------------------------------------------------------#

        axis.set_xlim(-self.BOUND_X, self.BOUND_X)
        axis.set_ylim(-self.BOUND_Y, self.BOUND_Y)
        axis.axis("off")
        axis.set_aspect("equal", adjustable="box")
        plt.show()

    def position(self, atom_index: int) -> list:
        """get the 2D positions of all lattice points for a specific atom"""
        coordinates = []

        lattice_vec_x_primitive = self.lattice_properties[self.lattice][
            "lattice_vec_x_primitive"
        ]
        lattice_vec_y_primitive = self.lattice_properties[self.lattice][
            "lattice_vec_y_primitive"
        ]

        for i in range(-MAX_POINTS_X + 1, MAX_POINTS_X + 1):
            for j in range(-MAX_POINTS_Y + 1, MAX_POINTS_Y + 1):
                x_coordinate = (
                    self.basis[atom_index][0]
                    + i * lattice_vec_x_primitive[0]
                    + j * lattice_vec_y_primitive[0]
                )
                y_coordinate = (
                    self.basis[atom_index][1]
                    + i * lattice_vec_x_primitive[1]
                    + j * lattice_vec_y_primitive[1]
                )

                if x_coordinate > -self.BOUND_X and x_coordinate < self.BOUND_X + 1:
                    if y_coordinate > -self.BOUND_Y and y_coordinate < self.BOUND_Y + 1:
                        coordinates.append(
                            (x_coordinate, y_coordinate)
                        )  # Bravais lattice points
                        self.coordinates.append(
                            (x_coordinate, y_coordinate)
                        )  # save the lattice points of all atoms

        return coordinates

    def get_nearest_neighbor_distance(self):
        """Calculate the nearest neighbor distance and filter all the corresponding vectors.
        Search all pairs in self.coordinates and compute their difference.
        if the distance of two coordinates is the smallest connect the points.
        """
        for j in range(len(self.coordinates)):
            for i in range(len(self.coordinates)):
                x1 = round(self.coordinates[j][0], 2)
                y1 = round(self.coordinates[j][1], 2)

                x2 = round(self.coordinates[i][0], 2)
                y2 = round(self.coordinates[i][1], 2)

                dr = math.sqrt((x1 - x2) ** 2 + (y1 - y2) ** 2)
                dr_min = self.lattice_consts[0]

                if dr >= 0.0 and dr <= dr_min:
                    plt.plot((x1, x2), (y1, y2), c="grey", lw=0.5)


def main() -> None:
    """Test"""

    # r_{Na+} = 0.98, r_{Cl-} = 1.81
    a_NaCl = 5.64
    basis_Na = [0.0 * a_NaCl, 0.0 * a_NaCl]
    basis_Cl = [0.0, 0.5 * a_NaCl]
    # basis_Cl    = [ 0.5 * a_NaCl, 0.0 ]
    radius_Na = 0.98
    radius_Cl = 1.81
    NaCl = CrystalStructure(
        "Centered Rectangular",
        [basis_Na, basis_Cl],
        [radius_Na, radius_Cl],
        ["red", "blue"],
        ["Na+", "Cl-"],
        [a_NaCl, a_NaCl],
    )
    NaCl.draw()

    # Graphene
    a_Graphen = 2.46
    basis_C1 = a_Graphen / 2 * np.array([1, math.sqrt(3)])
    basis_C2 = a_Graphen / 2 * np.array([-1, math.sqrt(3)])
    Graphen = CrystalStructure(
        "Hexagonal",
        [basis_C1, basis_C2],
        [1.7, 1.7],
        ["blue", "red"],
        ["C", "C"],
        [a_Graphen, a_Graphen],
    )
    Graphen.draw()

    # Anti-ferromagnetic lattice

    a = 1
    basis_up = np.array([0.0, 0.0])
    basis_down = np.array([1 / 2 * a, 1 / 2 * a])
    AFM = CrystalStructure(
        "Square",
        [basis_up, basis_down],
        [2, 2],
        ["red", "blue"],
        ["up", "down"],
        [a, a],
    )
    AFM.draw()


main()
