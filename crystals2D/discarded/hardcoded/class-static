"""
Write a class which includes a 2D Bravais lattice and where an basis can be included.
"""


#### Modules
import math
import numpy as np
import matplotlib.pyplot as plt

#### Global constants

RED = '#FF0000'


#### The class
class Bravais2D:
    """ Create all Bravais lattices in 2D. """
    LATTICE_SYSTEM          = { "Monoclinic", "Orthorhombic", "Tetragonal", "Hexagonal" }
    BRAVAIS_LATTICE         = { "Oblique", "Rectangular", "Centered Rectangular", "Square", "Hexagonal"}
    MAX_POINTS_X            = 4
    MAX_POINTS_Y            = 4

    def __init__(self, length_1 = 1.0, length_2 = 1.0, theta = 90.0, centered = False):

        self.length_1       = length_1
        self.length_2       = length_2
        self.theta          = theta
        self.centered       = centered

        self.x_coordinate   = []
        self.y_coordinate   = []

    def vec_1(self):
        """ Get the first lattice basis vector"""
        vec_1 = self.length_1 * np.array( [ 1.0, 0.0 ] )
        return vec_1

    def vec_2(self):
        """ Get the second lattice basis vector"""
        vec_2 = self.length_2 * np.array( [ math.cos(self.theta * math.pi / 180.00) ,\
                                             math.sin(self.theta * math.pi / 180.00)])
        return vec_2

    def points(self):
        """ Get the coordinates of the points """
        x_coordinate = self.x_coordinate
        y_coordinate = self.y_coordinate
        if not self.centered:
            for i in range( -self.MAX_POINTS_X + 1, self.MAX_POINTS_X + 1 ):
                for j in range( -self.MAX_POINTS_Y + 1, self.MAX_POINTS_Y + 1 ):
                    x_coordinate.append( i * self.vec_1()[0] + j * self.vec_2()[0] )
                    y_coordinate.append( i * self.vec_1()[1] + j * self.vec_2()[1] )
        else:
            for i in range( -self.MAX_POINTS_X + 1, self.MAX_POINTS_X + 1 ):
                for j in range( -self.MAX_POINTS_Y + 1, self.MAX_POINTS_Y + 1 ):
                    x_coordinate.append( i * self.vec_1()[0] + j * self.vec_2()[0] )
                    y_coordinate.append( i * self.vec_1()[1] + j * self.vec_2()[1] )
                    x_coordinate.append( 1 / 2 * ( self.vec_1()[0] + self.vec_2()[0]) \
                                            + i * self.vec_1()[0] + j * self.vec_2()[0] )
                    y_coordinate.append( 1 / 2 * ( self.vec_1()[1] + self.vec_2()[1]) \
                                            + i * self.vec_1()[1] + j * self.vec_2()[1] )
        return x_coordinate, y_coordinate

    def draw(self):
        """ Draw the lattice of points """
        fig, axis = plt.subplots()
        axis.plot((0, self.vec_1()[0]), (0, self.vec_1()[1]), c = 'red')
        axis.plot((0, self.vec_2()[0]), (0, self.vec_2()[1]), c = 'red')
        axis.scatter(self.points()[0], self.points()[1], s = 5,  c = 'black')

        axis.axis('off')
        axis.set_aspect('equal', adjustable='box')
        plt.show()


