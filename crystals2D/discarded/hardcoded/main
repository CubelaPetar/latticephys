"""
Plot a Bravais lattice in 2D given the length of two basis lattice vectors
and the angle between them.
"""
##### Milestones:
# 1. Plot Bravais Lattice - DONE
# 2. Include atom basis
# 3. Inlcude phonon spectrum
# 4. Compute tight-binding electrom spectrum


##### Modules
import math
import numpy as np
import matplotlib.pylab as plt

##### Constants
DIMESNION           = 2
LATTICE_SYSTEM      = {"Monoclinic", "Orthorhombic", "Tetragonal", "Hexagonal"}
PRIMITIVE           = False
MAX_POINTS_X        = 4
MAX_POINTS_Y        = 4

# find greatest common divisor
def gcd(a, b) -> int:
    """Calculate the Greatest Common Divisor of a and b.

    Unless b==0, the result will have the same sign as b (so that when
    b is divided by it, the result comes out positive).
    """
    while b:
        a, b = b, a%b
    return a

print("This program plots a Bravais lattice where you have to chose the lenght of the \
lattice basis vectors and the corresponding angles between them. \n Are you ready?")
input()
print("Great! Follow the instructions.")

a               = float(input("Insert the length of the first lattice vector: a = "))
b               = float(input("Insert the length of the second lattice vector: b = "))
theta_degree    = float(input("Insert the angle between the vectors: (in degree) theta = "))
theta           = math.pi * theta_degree / 180.0

if (a == 0 or b == 0 or theta_degree == 0 or theta_degree == 180 or theta_degree == 360):
    raise Exception(" You chose an illegal angle or length!")

GCD             = gcd(a,b)
a               = a / GCD
b               = b / GCD


### Check lattice system
if (a == b and theta_degree == 90.0):
    print("\n You chose a Tetragonal lattice")
elif (a == b and (theta_degree in ( 60.00, 120.00))):
    print("\n You chose a Hexagonal lattice")
elif (a != b and theta_degree == 90.0):
    print("\n You chose a Orthorhombic lattice")
    if a > b:
        MAX_POINTS_Y = MAX_POINTS_X + int(2 * round(a-b,0))
    else:
        MAX_POINTS_X = MAX_POINTS_Y + int(2 * round(b-a,0))
    centered = input("Do you want a centered rectangluar? y/n \n")
    if centered == "n":
        PRIMITIVE = False
    else:
        PRIMITIVE = True
else:
    print("\n You chose a Monoclinic lattice")

### Define the lattice basis vectors
a1  = a * np.array( [ 1.0, 0. ] )
a2  = b * np.array( [ math.cos(theta), math.sin(theta) ] )

### Mathematical points in space
x_coordinates = []
y_coordinates = []
if not PRIMITIVE:
    for i in range( -MAX_POINTS_X + 1, MAX_POINTS_X + 1 ):
        for j in range( -MAX_POINTS_Y + 1, MAX_POINTS_Y + 1 ):
            x_coordinates.append( i * a1[0] + j * a2[0] )
            y_coordinates.append( i * a1[1] + j * a2[1] )
else:
    for i in range( -MAX_POINTS_X + 1, MAX_POINTS_X + 1 ):
        for j in range( -MAX_POINTS_Y + 1, MAX_POINTS_Y + 1 ):
            x_coordinates.append( i * a1[0] + j * a2[0] )
            y_coordinates.append( i * a1[1] + j * a2[1] )
            x_coordinates.append( 1/2 * ( a1[0] + a2[0] ) + i * a1[0] + j * a2[0] ) # centered lattice
            y_coordinates.append( 1/2 * ( a1[1] + a2[1] ) + i * a1[1] + j * a2[1] ) # centered lattice



fig, ax = plt.subplots(figsize = (5,5))
ax.plot((0,a1[0]), (0,a1[1]), c = 'red')
ax.plot((0,a2[0]), (0,a2[1]), c = 'red')
ax.scatter(x_coordinates, y_coordinates, s = 5,  c = 'black')

ax.axis('off')
ax.set_aspect('equal', adjustable='box')
plt.show()
# get a basis for the system and output the crystal structure and the number of phonons
