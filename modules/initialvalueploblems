"""
Class for solving initial value harmonic oscillator problems and drawing it with pygame
"""

#------# Modules #--------#

import pygame

#-------------------------#


class Atoms():
    """ Create all atoms coupled by springs a molecule or lattice"""

    TIMESTEP = .01       
    SCALE    = 50
    WIDTH, HEIGHT = 800, 800

    def __init__(self, N:int, x: float, y: float, p_x: float, p_y: float, mass: float, spring_const: float, color: tuple, radius: float):
        self.N              = N
        self.x              = x
        self.y              = y
        self.p_x            = p_x
        self.p_y            = p_y

        self.rx0            = 0
        self.ry0            = 0

        self.mass           = mass
        self.spring_const   = spring_const

        self.color          = color
        self.radius         = radius

        self.trajectory     = []
        self.momentum       = []


    def draw(self, win):
        x                    = self.x * self.SCALE + self.WIDTH /2
        y                    = self.y * self.SCALE + self.HEIGHT /2

        if len(self.trajectory) > 2:
            updated_points      = []
            for point in self.trajectory:
                x, y             = point
                x                = (self.rx0 + x) * self.SCALE + self.WIDTH /2
                y                = (self.ry0 + y) * self.SCALE + self.HEIGHT /2
                updated_points.append((x, y))

            #pygame.draw.lines(win, self.color, False, updated_points, 2)

        pygame.draw.circle(win, self.color, (x, y), self.radius)

    def attraction(self, other):
        other_x, other_y     = other.x, other.y
        distance_x           = self.x - other_x 
        distance_y           = self.y - other_y

        force_x              = 0.
        force_y              = 0.

        force_x              = - self.spring_const * distance_x
        force_y              = - self.spring_const * distance_y

        return force_x, force_y

    def velocity(self):
        velocity_x                  = self.p_x / self.mass
        velocity_y                  = self.p_y / self.mass

        return velocity_x, velocity_y

    def update_position(self, atoms) -> None:
        total_fx = total_fy      = 0.0
        total_vx = total_vy      = 0.0

        index               = atoms.index(self)

        if index == 0:
            fx, fy              = self.attraction(atoms[index+1])
        elif index == (self.N - 1):
            fx, fy              = self.attraction(atoms[index-1])
        else:
            fx, fy              = self.attraction(atoms[index-1])
            fx                 += self.attraction(atoms[index+1])[0]
            fy                 += self.attraction(atoms[index+1])[1]

        vx, vy              = self.velocity()
        total_fx           += fx
        total_fy           += fy
        total_vx           += vx
        total_vy           += vy


        self.p_x          += total_fx * self.TIMESTEP
        self.p_y          += total_fy * self.TIMESTEP
        if index == 0 or index == (self.N - 1):
            self.x = 0
            self.y = 0
        else:
            self.x            += total_vx * self.TIMESTEP
            self.y            += total_vy * self.TIMESTEP

        self.trajectory.append((self.x, self.y))
        self.momentum.append((self.p_x, self.p_y))

